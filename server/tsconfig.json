{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",

    "rootDir": "./src",
    "outDir": "./dist",

    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,

    "types": ["node"],

    "allowJs": true,
    "checkJs": false,

    "skipLibCheck": true
  },
  "include": ["src/**/*", "test.ts"]
}